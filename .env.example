# For public IPv4, set COMPOSE_FILE=compose.yaml:compose.ip.yaml and DOMAIN to the IP.
COMPOSE_PROJECT_NAME=echo-listen
COMPOSE_FILE=compose.yaml
DOMAIN=listen.example.com
PUBLIC_URL=wss://listen.example.com
SERVER_NAME=ECHO Listening Room
HOST=0.0.0.0
PORT=8787
MAX_USERS=200
MAX_ROOMS=30
MAX_ROOM_USERS=10
RECONNECT_SECONDS=20
EMPTY_ROOM_SECONDS=60
# Optional server access password. Never share ADMIN_TOKEN.
SERVER_PASSWORD=
ADMIN_TOKEN=replace-with-a-random-admin-token
